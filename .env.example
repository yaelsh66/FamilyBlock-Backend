# Spring profile to load application-prod.properties.
SPRING_PROFILES_ACTIVE=prod

# Server binding. Render provides PORT automatically.
PORT=8081
SERVER_ADDRESS=0.0.0.0

# PostgreSQL connection.
# Render/Supabase example format:
# jdbc:postgresql://host:5432/database?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DB_PASSWORD=

# Comma-separated frontend origins allowed by CORS.
# Local + production example:
# http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin credentials.
# Prefer FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON on hosted platforms.
# For local development, use FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=src/main/resources/firebase/serviceAccountKey.json

# Gemini API configuration.
GEMINI_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
GEMINI_MODEL=models/gemini-2.5-flash

# OpenAI configuration is currently present in Spring config.
OPEN_AI_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o

# Local directories that contain downloadable agent artifacts.
DOWNLOADS_PATH=
DOWNLOADS_UI_PATH=
DOWNLOADS_AGENT_INSTALLER_PATH=

# Production database safety setting.
# Use validate/update intentionally; avoid create/create-drop in production.
HIBERNATE_DDL_AUTO=update

# SQL logging.
JPA_SHOW_SQL=false
